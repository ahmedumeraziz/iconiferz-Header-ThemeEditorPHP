// ================================================================
// iCONIFERz — SEO Code (hooked into wp_head, safe for Avada)
// Place this ABOVE the DOCTYPE line, runs via add_action()
// ================================================================

add_action( 'wp_head', 'iconiferz_seo_head', 1 );

function iconiferz_seo_head() {

	// --- REMOVE DUPLICATE TITLE TAG (WordPress outputs one via wp_head) ---
	// We hook ours in early (priority 1) to avoid duplication.
	// WordPress default title is removed below so ours is the only one.

	// --- GLOBAL META (all pages) ---
	echo '<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">' . "\n";
	echo '<meta name="author" content="iCONIFERz">' . "\n";
	echo '<meta property="og:site_name" content="iCONIFERz">' . "\n";
	echo '<meta property="og:locale" content="en_US">' . "\n";

	// ---------------------------------------------------------------
	// HOMEPAGE
	// ---------------------------------------------------------------
	if ( is_front_page() ) {

		echo '<meta name="description" content="Stay ahead with iCONIFERz – your trusted source for the latest technology news, AI breakthroughs, cybersecurity, mobile tech, and innovation insights. Updated daily.">' . "\n";
		echo '<link rel="canonical" href="https://iconiferz.com/" />' . "\n";

		// Open Graph
		echo '<meta property="og:type" content="website">' . "\n";
		echo '<meta property="og:title" content="Technology News &amp; Insights | iCONIFERz">' . "\n";
		echo '<meta property="og:description" content="Stay ahead with iCONIFERz – your trusted source for the latest technology news, AI, cybersecurity, mobile tech, and innovation insights.">' . "\n";
		echo '<meta property="og:url" content="https://iconiferz.com/">' . "\n";
		echo '<meta property="og:image" content="https://iconiferz.com/wp-content/uploads/2025/07/iCONIFERz-Logo.webp">' . "\n";
		echo '<meta property="og:image:width" content="1200">' . "\n";
		echo '<meta property="og:image:height" content="630">' . "\n";

		// Twitter Card
		echo '<meta name="twitter:card" content="summary_large_image">' . "\n";
		echo '<meta name="twitter:title" content="Technology News &amp; Insights | iCONIFERz">' . "\n";
		echo '<meta name="twitter:description" content="Stay ahead with iCONIFERz – your trusted source for the latest technology news, AI, cybersecurity, mobile tech, and innovation insights.">' . "\n";
		echo '<meta name="twitter:image" content="https://iconiferz.com/wp-content/uploads/2025/07/iCONIFERz-Logo.webp">' . "\n";

		// Homepage WebPage Schema — dateModified uses last published post, not server time
		$hp_schema = array(
			'@context'    => 'https://schema.org',
			'@type'       => 'WebPage',
			'name'        => 'Technology News & Insights | iCONIFERz',
			'url'         => 'https://iconiferz.com/',
			'description' => 'Stay ahead with iCONIFERz – your trusted source for the latest technology news, AI, cybersecurity, mobile tech, and innovation insights.',
			'inLanguage'  => 'en-US',
			'isPartOf'    => array(
				'@type' => 'WebSite',
				'name'  => 'iCONIFERz',
				'url'   => 'https://iconiferz.com',
			),
			'publisher'   => array(
				'@type' => 'Organization',
				'name'  => 'iCONIFERz',
				'logo'  => array(
					'@type' => 'ImageObject',
					'url'   => 'https://iconiferz.com/wp-content/uploads/2025/07/iCONIFERz-Logo.webp',
				),
			),
			// Use last post modified date instead of live server time
			'dateModified' => get_lastpostmodified( 'c' ),
		);
		echo '<script type="application/ld+json">' . wp_json_encode( $hp_schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
	}

	// ---------------------------------------------------------------
	// SINGLE POSTS
	// ---------------------------------------------------------------
	if ( is_single() ) {
		global $post;

		$post_url    = esc_url( get_permalink() );
		$post_title  = esc_attr( get_the_title() );
		$post_exc    = esc_attr( wp_strip_all_tags( get_the_excerpt() ) );
		$post_img    = get_the_post_thumbnail_url( $post->ID, 'large' );
		$pub_date    = get_the_date( 'c' );
		$mod_date    = get_the_modified_date( 'c' );
		$author_obj  = get_userdata( $post->post_author );
		$author_name = $author_obj ? esc_attr( $author_obj->display_name ) : 'iCONIFERz';
		$author_url  = esc_url( get_author_posts_url( $post->post_author ) );

		echo '<meta name="description" content="' . $post_exc . '">' . "\n";
		echo '<link rel="canonical" href="' . $post_url . '" />' . "\n";

		// Open Graph
		echo '<meta property="og:type" content="article">' . "\n";
		echo '<meta property="og:title" content="' . $post_title . '">' . "\n";
		echo '<meta property="og:description" content="' . $post_exc . '">' . "\n";
		echo '<meta property="og:url" content="' . $post_url . '">' . "\n";
		if ( $post_img ) {
			echo '<meta property="og:image" content="' . esc_url( $post_img ) . '">' . "\n";
		}
		echo '<meta property="article:published_time" content="' . $pub_date . '">' . "\n";
		echo '<meta property="article:modified_time" content="' . $mod_date . '">' . "\n";

		// Twitter Card
		echo '<meta name="twitter:card" content="summary_large_image">' . "\n";
		echo '<meta name="twitter:title" content="' . $post_title . '">' . "\n";
		echo '<meta name="twitter:description" content="' . $post_exc . '">' . "\n";
		if ( $post_img ) {
			echo '<meta name="twitter:image" content="' . esc_url( $post_img ) . '">' . "\n";
		}

		// BlogPosting Schema — image only added when thumbnail exists
		$article_schema = array(
			'@context'         => 'https://schema.org',
			'@type'            => 'BlogPosting',
			'headline'         => get_the_title(),
			'url'              => get_permalink(),
			'datePublished'    => $pub_date,
			'dateModified'     => $mod_date,
			'author'           => array(
				'@type' => 'Person',
				'name'  => $author_name,
				'url'   => $author_url,
			),
			'publisher'        => array(
				'@type' => 'Organization',
				'name'  => 'iCONIFERz',
				'logo'  => array(
					'@type'  => 'ImageObject',
					'url'    => 'https://iconiferz.com/wp-content/uploads/2025/07/iCONIFERz-Logo.webp',
					'width'  => 1000,
					'height' => 300,
				),
			),
			'description'      => wp_strip_all_tags( get_the_excerpt() ),
			'mainEntityOfPage' => array(
				'@type' => 'WebPage',
				'@id'   => get_permalink(),
			),
			'inLanguage'       => 'en-US',
		);

		// Only add image to schema if thumbnail exists
		if ( $post_img ) {
			$article_schema['image'] = array(
				'@type' => 'ImageObject',
				'url'   => $post_img,
			);
		}

		echo '<script type="application/ld+json">' . wp_json_encode( $article_schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
	}

	// ---------------------------------------------------------------
	// CATEGORY PAGES
	// ---------------------------------------------------------------
	if ( is_category() ) {
		$cat_obj  = get_queried_object();
		$cat_name = esc_attr( $cat_obj->name );
		$cat_url  = esc_url( get_category_link( $cat_obj->term_id ) );
		$cat_desc = strip_tags( $cat_obj->description );
		$cat_meta = $cat_desc
			? esc_attr( $cat_desc )
			: 'Browse all ' . $cat_name . ' articles on iCONIFERz – latest news and insights.';

		echo '<meta name="description" content="' . $cat_meta . '">' . "\n";
		echo '<link rel="canonical" href="' . $cat_url . '" />' . "\n";

		// Open Graph
		echo '<meta property="og:type" content="website">' . "\n";
		echo '<meta property="og:title" content="' . $cat_name . ' News &amp; Insights | iCONIFERz">' . "\n";
		echo '<meta property="og:description" content="' . $cat_meta . '">' . "\n";
		echo '<meta property="og:url" content="' . $cat_url . '">' . "\n";
		echo '<meta property="og:image" content="https://iconiferz.com/wp-content/uploads/2025/07/iCONIFERz-Logo.webp">' . "\n";

		// Twitter Card
		echo '<meta name="twitter:card" content="summary_large_image">' . "\n";
		echo '<meta name="twitter:title" content="' . $cat_name . ' News &amp; Insights | iCONIFERz">' . "\n";
		echo '<meta name="twitter:description" content="' . $cat_meta . '">' . "\n";
		echo '<meta name="twitter:image" content="https://iconiferz.com/wp-content/uploads/2025/07/iCONIFERz-Logo.webp">' . "\n";
	}

	// ---------------------------------------------------------------
	// AUTHOR ARCHIVE
	// ---------------------------------------------------------------
	if ( is_author() ) {
		$author     = get_queried_object(); // Fix: get_the_author() fails outside the Loop
		$auth_name  = esc_attr( $author->display_name );
		$auth_url   = esc_url( get_author_posts_url( $author->ID ) );
		$auth_bio   = esc_attr( $author->description );
		$auth_meta  = $auth_bio ? $auth_bio : $auth_name . ' – Author at iCONIFERz Technology News.';

		echo '<meta name="description" content="' . $auth_meta . '">' . "\n";
		echo '<link rel="canonical" href="' . $auth_url . '" />' . "\n";

		// Open Graph
		echo '<meta property="og:type" content="website">' . "\n";
		echo '<meta property="og:title" content="' . $auth_name . ' | iCONIFERz">' . "\n";
		echo '<meta property="og:description" content="' . $auth_meta . '">' . "\n";
		echo '<meta property="og:url" content="' . $auth_url . '">' . "\n";

		// Twitter Card
		echo '<meta name="twitter:card" content="summary">' . "\n";
		echo '<meta name="twitter:title" content="' . $auth_name . ' | iCONIFERz">' . "\n";
		echo '<meta name="twitter:description" content="' . $auth_meta . '">' . "\n";
	}

	// ---------------------------------------------------------------
	// TAG ARCHIVE
	// ---------------------------------------------------------------
	if ( is_tag() ) {
		$tag_obj  = get_queried_object();
		$tag_name = esc_attr( $tag_obj->name );
		$tag_url  = esc_url( get_tag_link( $tag_obj->term_id ) );
		$tag_desc = strip_tags( $tag_obj->description );
		$tag_meta = $tag_desc
			? esc_attr( $tag_desc )
			: 'Articles tagged "' . $tag_name . '" on iCONIFERz – latest technology news and insights.';

		echo '<meta name="description" content="' . $tag_meta . '">' . "\n";
		echo '<link rel="canonical" href="' . $tag_url . '" />' . "\n";
		echo '<meta property="og:type" content="website">' . "\n";
		echo '<meta property="og:title" content="' . $tag_name . ' | iCONIFERz">' . "\n";
		echo '<meta property="og:url" content="' . $tag_url . '">' . "\n";

		// Twitter Card
		echo '<meta name="twitter:card" content="summary">' . "\n";
		echo '<meta name="twitter:title" content="' . $tag_name . ' | iCONIFERz">' . "\n";
	}

	// ---------------------------------------------------------------
	// STATIC PAGES (About, Contact, etc.)
	// ---------------------------------------------------------------
	if ( is_page() && ! is_front_page() ) {
		global $post;
		$page_url   = esc_url( get_permalink() );
		$page_title = esc_attr( get_the_title() );
		$page_exc   = esc_attr( wp_strip_all_tags( get_the_excerpt() ) );
		$page_img   = get_the_post_thumbnail_url( $post->ID, 'large' );

		if ( $page_exc ) {
			echo '<meta name="description" content="' . $page_exc . '">' . "\n";
		}
		echo '<link rel="canonical" href="' . $page_url . '" />' . "\n";

		// Open Graph
		echo '<meta property="og:type" content="website">' . "\n";
		echo '<meta property="og:title" content="' . $page_title . ' | iCONIFERz">' . "\n";
		echo '<meta property="og:url" content="' . $page_url . '">' . "\n";
		if ( $page_img ) {
			echo '<meta property="og:image" content="' . esc_url( $page_img ) . '">' . "\n";
		}

		// Twitter Card
		echo '<meta name="twitter:card" content="summary_large_image">' . "\n";
		echo '<meta name="twitter:title" content="' . $page_title . ' | iCONIFERz">' . "\n";
		if ( $page_exc ) {
			echo '<meta name="twitter:description" content="' . $page_exc . '">' . "\n";
		}
		if ( $page_img ) {
			echo '<meta name="twitter:image" content="' . esc_url( $page_img ) . '">' . "\n";
		}
	}

	// ---------------------------------------------------------------
	// SPEED: Preconnect & DNS Prefetch (all pages)
	// ---------------------------------------------------------------
	echo '<link rel="preconnect" href="https://fonts.googleapis.com">' . "\n";
	echo '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>' . "\n";
	echo '<link rel="dns-prefetch" href="//fonts.googleapis.com">' . "\n";
	echo '<link rel="dns-prefetch" href="//fonts.gstatic.com">' . "\n";
	echo '<link rel="dns-prefetch" href="//www.google-analytics.com">' . "\n";
	echo '<link rel="dns-prefetch" href="//www.googletagmanager.com">' . "\n";

	// Logo preload (LCP priority)
	echo '<link rel="preload" as="image" fetchpriority="high" href="https://iconiferz.com/wp-content/uploads/2025/07/iCONIFERz-Logo.webp">' . "\n";

	// ---------------------------------------------------------------
	// ORGANIZATION SCHEMA (all pages)
	// ---------------------------------------------------------------
	$org_schema = array(
		'@context'      => 'https://schema.org',
		'@type'         => 'Organization',
		'name'          => 'iCONIFERz',
		'alternateName' => 'iCONIFERz Technology News',
		'url'           => 'https://iconiferz.com',
		'logo'          => array(
			'@type'  => 'ImageObject',
			'url'    => 'https://iconiferz.com/wp-content/uploads/2025/07/iCONIFERz-Logo.webp',
			'width'  => 1000,
			'height' => 300,
		),
		'description'   => 'iCONIFERz is a leading technology news platform covering AI, cybersecurity, mobile tech, blockchain, robotics, space and more.',
		'foundingDate'  => '2019',
		'email'         => 'info@iconiferz.com',
		'sameAs'        => array(
			'https://www.facebook.com/iconiferz',
			'https://www.linkedin.com/company/iconiferz',
			'https://www.tumblr.com/iconiferz',
			'https://medium.com/@iconiferz',
			'https://www.instagram.com/iconiferz/',
			'https://bsky.app/profile/iconiferz.bsky.social/',
			'https://www.threads.com/@iconiferz',
		),
		'contactPoint'  => array(
			'@type'       => 'ContactPoint',
			'email'       => 'info@iconiferz.com',
			'contactType' => 'editorial',
		),
	);
	echo '<script type="application/ld+json">' . wp_json_encode( $org_schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";

	// ---------------------------------------------------------------
	// WEBSITE SCHEMA + SITELINKS SEARCH BOX (all pages)
	// ---------------------------------------------------------------
	$site_schema = array(
		'@context'       => 'https://schema.org',
		'@type'          => 'WebSite',
		'name'           => 'iCONIFERz',
		'url'            => 'https://iconiferz.com',
		'description'    => 'Technology News and Insights – AI, Cybersecurity, Mobile, Blockchain, Space and more.',
		'inLanguage'     => 'en-US',
		'potentialAction' => array(
			'@type'       => 'SearchAction',
			'target'      => array(
				'@type'       => 'EntryPoint',
				'urlTemplate' => 'https://iconiferz.com/?s={search_term_string}',
			),
			'query-input' => 'required name=search_term_string',
		),
	);
	echo '<script type="application/ld+json">' . wp_json_encode( $site_schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
}

// ================================================================
// REMOVE DUPLICATE TITLE TAG
// WordPress outputs <title> via wp_head. We keep that default
// and control it via the filter below instead of echoing our own.
// ================================================================
add_filter( 'pre_get_document_title', 'iconiferz_custom_title' );

function iconiferz_custom_title( $title ) {
	if ( is_front_page() ) {
		return 'Technology News &amp; Insights | iCONIFERz – AI, Cyber, Mobile &amp; More';
	} elseif ( is_single() ) {
		return get_the_title() . ' | iCONIFERz';
	} elseif ( is_category() ) {
		return single_cat_title( '', false ) . ' News &amp; Insights | iCONIFERz';
	} elseif ( is_tag() ) {
		return single_tag_title( '', false ) . ' | iCONIFERz';
	} elseif ( is_author() ) {
		$author = get_queried_object();
		return ( $author ? $author->display_name : 'Author' ) . ' | iCONIFERz';
	} elseif ( is_page() ) {
		return get_the_title() . ' | iCONIFERz';
	}
	return $title; // fallback to WordPress default for all other cases
}
