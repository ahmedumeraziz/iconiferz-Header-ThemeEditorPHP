	$cache_key = 'soopercart_static_schemas';
	$cached    = get_transient( $cache_key );
	if ( $cached ) {
		return $cached;
	}

	$org_schema = array(
		'@context'      => 'https://schema.org',
		'@type'         => 'Organization',
		'name'          => 'SooperCart',
