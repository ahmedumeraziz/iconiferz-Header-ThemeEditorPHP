// HELPER — BreadcrumbList schema
// ════════════════════════════════════════════════════════════════
if ( ! function_exists( 'sc_breadcrumb_schema' ) ) {
	function sc_breadcrumb_schema() {
		$items = array();
		$pos   = 1;
		$items[] = array( '@type' => 'ListItem', 'position' => $pos++, 'name' => 'Home', 'item' => home_url( '/' ) );

		if ( is_single() ) {
			$cats = get_the_category();
			if ( ! empty( $cats ) ) {
				$items[] = array( '@type' => 'ListItem', 'position' => $pos++, 'name' => esc_html( $cats[0]->name ), 'item' => esc_url( get_category_link( $cats[0]->term_id ) ) );
			}
			$items[] = array( '@type' => 'ListItem', 'position' => $pos++, 'name' => esc_html( get_the_title() ), 'item' => esc_url( get_permalink() ) );
		} elseif ( is_category() ) {
			$cat = get_queried_object();
			$items[] = array( '@type' => 'ListItem', 'position' => $pos++, 'name' => esc_html( $cat->name ), 'item' => esc_url( get_category_link( $cat->term_id ) ) );
		} elseif ( is_tag() ) {
			$tag = get_queried_object();
			$items[] = array( '@type' => 'ListItem', 'position' => $pos++, 'name' => esc_html( $tag->name ), 'item' => esc_url( get_tag_link( $tag->term_id ) ) );
		} elseif ( is_author() ) {
			$author = get_queried_object();
			$items[] = array( '@type' => 'ListItem', 'position' => $pos++, 'name' => esc_html( $author->display_name ), 'item' => esc_url( get_author_posts_url( $author->ID ) ) );
		} elseif ( is_page() && ! is_front_page() ) {
			$items[] = array( '@type' => 'ListItem', 'position' => $pos++, 'name' => esc_html( get_the_title() ), 'item' => esc_url( get_permalink() ) );
		}

		if ( count( $items ) < 2 ) { return; }
		$schema = array( '@context' => 'https://schema.org', '@type' => 'BreadcrumbList', 'itemListElement' => $items );
		echo '<script type="application/ld+json">' . wp_json_encode( $schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
	}
}


// ════════════════════════════════════════════════════════════════
// HELPER — extract plain text from <p> tags in HTML fragment
// ════════════════════════════════════════════════════════════════
if ( ! function_exists( 'sc_para_text' ) ) {
	function sc_para_text( $html ) {
		$parts = array();
		if ( preg_match_all( '/<p[^>]*>([\s\S]*?)<\/p>/i', $html, $m ) ) {
			foreach ( $m[1] as $p ) {
				$t = trim( wp_strip_all_tags( $p ) );
				if ( $t ) { $parts[] = $t; }
			}
		}
		if ( empty( $parts ) ) {
			$t = trim( wp_strip_all_tags( $html ) );
			if ( $t ) { $parts[] = $t; }
		}
		return implode( ' ', $parts );
	}
}


// ════════════════════════════════════════════════════════════════
// HELPER — auto-detect FAQ pairs (4 methods)
// ════════════════════════════════════════════════════════════════
if ( ! function_exists( 'sc_extract_faqs' ) ) {
	function sc_extract_faqs( $content ) {
		$faqs     = array();
		$rendered = function_exists( 'do_blocks' ) ? do_blocks( $content ) : $content;
		$faq_kw   = array( 'faq', 'frequently asked', 'common question', 'question', 'spec', 'specification', 'buying guide' );

		// Method 1 — Gutenberg H2 FAQ section → H3/H4 questions
		$h2_parts = preg_split( '/<h2[^>]*>[\s\S]*?<\/h2>/i', $rendered );
		preg_match_all( '/<h2[^>]*>([\s\S]*?)<\/h2>/i', $rendered, $h2m, PREG_SET_ORDER );
		foreach ( $h2m as $idx => $hm ) {
			$h2_text = strtolower( trim( wp_strip_all_tags( $hm[1] ) ) );
			$ok = false;
			foreach ( $faq_kw as $kw ) { if ( strpos( $h2_text, $kw ) !== false ) { $ok = true; break; } }
			if ( ! $ok || empty( $h2_parts[ $idx + 1 ] ) ) { continue; }
			if ( preg_match_all( '/<h[3-4][^>]*>([\s\S]*?)<\/h[3-4]>([\s\S]*?)(?=<h[2-4]|$)/i', $h2_parts[ $idx + 1 ], $qm, PREG_SET_ORDER ) ) {
				foreach ( $qm as $q ) {
					$question = preg_replace( '/^Q\d+[\.\:\)]\s*/i', '', trim( wp_strip_all_tags( $q[1] ) ) );
					if ( ! $question || '?' !== substr( rtrim( $question ), -1 ) ) { continue; }
					$answer = sc_para_text( $q[2] );
					if ( $answer ) { $faqs[] = array( 'question' => $question, 'answer' => $answer ); }
				}
			}
		}

		// Method 2 — Classic Editor <p><strong>Question?</strong></p>
		if ( empty( $faqs ) && preg_match_all( '/<p[^>]*>\s*<strong[^>]*>([\s\S]*?)<\/strong>\s*<\/p>([\s\S]*?)(?=<p[^>]*>\s*<strong|$)/i', $rendered, $m, PREG_SET_ORDER ) ) {
			foreach ( $m as $row ) {
				$question = preg_replace( '/^Q\d+[\.\:\)]\s*/i', '', trim( wp_strip_all_tags( $row[1] ) ) );
				if ( ! $question || '?' !== substr( rtrim( $question ), -1 ) ) { continue; }
				$answer = sc_para_text( $row[2] );
				if ( $answer ) { $faqs[] = array( 'question' => $question, 'answer' => $answer ); }
			}
		}

		// Method 3 — Definition list <dt>/<dd>
		if ( empty( $faqs ) && preg_match_all( '/<dt[^>]*>([\s\S]*?)<\/dt>[\s\S]{0,300}?<dd[^>]*>([\s\S]*?)<\/dd>/i', $rendered, $m, PREG_SET_ORDER ) ) {
			foreach ( $m as $row ) {
				$question = trim( wp_strip_all_tags( $row[1] ) );
				$answer   = trim( wp_strip_all_tags( $row[2] ) );
				if ( $question && $answer && '?' === substr( rtrim( $question ), -1 ) ) {
					$faqs[] = array( 'question' => $question, 'answer' => $answer );
				}
			}
		}

		// Method 4 — WP 6.3+ <details>/<summary> accordion
		if ( empty( $faqs ) && preg_match_all( '/<details[^>]*>[\s\S]{0,200}?<summary[^>]*>([\s\S]*?)<\/summary>([\s\S]*?)<\/details>/i', $rendered, $m, PREG_SET_ORDER ) ) {
			foreach ( $m as $row ) {
				$question = trim( wp_strip_all_tags( $row[1] ) );
				if ( ! $question || '?' !== substr( rtrim( $question ), -1 ) ) { continue; }
				$answer = sc_para_text( $row[2] );
				if ( $answer ) { $faqs[] = array( 'question' => $question, 'answer' => $answer ); }
			}
		}

		// Deduplicate
		$seen = array(); $clean = array();
		foreach ( $faqs as $f ) {
			$k = md5( $f['question'] );
			if ( ! isset( $seen[$k] ) ) { $seen[$k] = true; $clean[] = $f; }
		}
		return $clean;
	}
}


// ════════════════════════════════════════════════════════════════
// HELPER — output FAQPage JSON-LD block
// ════════════════════════════════════════════════════════════════
if ( ! function_exists( 'sc_output_faq_schema' ) ) {
	function sc_output_faq_schema( $content ) {
		$faqs = sc_extract_faqs( $content );
		if ( empty( $faqs ) ) { return; }
		$entities = array();
		foreach ( $faqs as $f ) {
			$entities[] = array(
				'@type'          => 'Question',
				'name'           => $f['question'],
				'acceptedAnswer' => array( '@type' => 'Answer', 'text' => $f['answer'] ),
			);
		}
		$schema = array( '@context' => 'https://schema.org', '@type' => 'FAQPage', 'mainEntity' => $entities );
		echo '<script type="application/ld+json">' . wp_json_encode( $schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
	}
}


// ════════════════════════════════════════════════════════════════
// HELPER — star rating from custom post meta
// ════════════════════════════════════════════════════════════════
if ( ! function_exists( 'sc_get_rating' ) ) {
	function sc_get_rating( $post_id ) {
		$r = get_post_meta( $post_id, '_sc_rating',       true );
		$c = get_post_meta( $post_id, '_sc_rating_count', true );
		if ( $r && $c ) { return array( 'ratingValue' => floatval( $r ), 'ratingCount' => intval( $c ) ); }
		return null;
	}
}


// ════════════════════════════════════════════════════════════════
// MAIN SEO HEAD — priority 1 (fires before all plugins + Avada)
// ════════════════════════════════════════════════════════════════
if ( ! function_exists( 'sc_seo_head' ) ) {
	function sc_seo_head() {

		// ── ROBOTS: noindex thin/duplicate pages ─────────────────
		if ( is_search() || is_404() || is_date() || is_paged() ) {
			echo '<meta name="robots" content="noindex, follow">' . "\n";
			echo '<meta name="GPTBot" content="noindex">' . "\n";
			echo '<meta name="ClaudeBot" content="noindex">' . "\n";
			echo '<meta name="PerplexityBot" content="noindex">' . "\n";
			return;
		}

		// Full indexing for all real content
		echo '<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">' . "\n";

		// ── AI CRAWLER OPT-IN ─────────────────────────────────────
		echo '<meta name="GPTBot" content="index">' . "\n";
		echo '<meta name="ClaudeBot" content="index">' . "\n";
		echo '<meta name="PerplexityBot" content="index">' . "\n";
		echo '<link rel="llms" href="' . esc_url( SC_SITE_URL . '/llms.txt' ) . '">' . "\n";

		// ── FIX 1 — meta-author: site name on all pages EXCEPT
		//    single posts where it outputs the actual post author
		// ─────────────────────────────────────────────────────────
		if ( is_single() ) {
			// On posts: always output Ahmed UA. as meta-author
			// (hardcoded via constant so it never falls back to
			//  the site-account display name "SooperCart")
			echo '<meta name="author" content="' . esc_attr( SC_AUTHOR_NAME ) . '">' . "\n";
		} else {
			// On all other pages: site name is correct
			echo '<meta name="author" content="' . esc_attr( SC_SITE_NAME ) . '">' . "\n";
		}

		// ── GLOBAL OG META ────────────────────────────────────────
		echo '<meta property="og:site_name" content="' . esc_attr( SC_SITE_NAME ) . '">' . "\n";
		echo '<meta property="og:locale" content="en_US">' . "\n";

		// ── TWITTER CARD global ───────────────────────────────────
		echo '<meta name="twitter:card" content="summary_large_image">' . "\n";
		echo '<meta name="twitter:site" content="' . esc_attr( SC_TWITTER ) . '">' . "\n";

		// ── SPEED: preconnect + DNS-prefetch ──────────────────────
		echo '<link rel="preconnect" href="https://fonts.googleapis.com">' . "\n";
		echo '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>' . "\n";
		echo '<link rel="dns-prefetch" href="//fonts.googleapis.com">' . "\n";
		echo '<link rel="dns-prefetch" href="//fonts.gstatic.com">' . "\n";
		echo '<link rel="dns-prefetch" href="//www.google-analytics.com">' . "\n";
		echo '<link rel="dns-prefetch" href="//www.googletagmanager.com">' . "\n";

