			echo '<meta name="twitter:image"       content="' . esc_url( SC_SOCIAL_IMG ) . '">' . "\n";

			$schema = array(
				'@context'     => 'https://schema.org',
				'@type'        => 'WebPage',
				'@id'          => SC_SITE_URL . '/#webpage',
				'name'         => $hp_title,
				'url'          => SC_SITE_URL . '/',
