// ================================================================
// ③ HELPER — get real mime type for og:image:type
//    Falls back to image/webp for the static fallback banner.
// ================================================================
function sc_image_mime( $attachment_id = 0 ) {
	if ( $attachment_id ) {
		$mime = get_post_mime_type( $attachment_id );
		if ( $mime ) {
			return esc_attr( $mime );
		}
	}
	return 'image/webp';
}


// ================================================================
// ④ HELPER — WP transient cache for Organization + WebSite JSON
//    Rebuilt at most every 12 hours, or instantly on any post save.
//    Returns a ready-to-echo HTML string of two <script> blocks.
// ================================================================
function sc_static_schemas() {
	$cache_key = 'sc_static_schemas_v3';
	$cached    = get_transient( $cache_key );
	if ( $cached ) {
		return $cached;
	}

	$org = array(
		'@context'      => 'https://schema.org',
		'@type'         => 'Organization',
		'@id'           => SC_SITE_URL . '/#organization',
		'name'          => SC_SITE_NAME,
		'alternateName' => SC_SITE_NAME . ' - ' . SC_SITE_TAGLINE,
		'url'           => SC_SITE_URL,
		'logo'          => array(
			'@type'  => 'ImageObject',
			'url'    => SC_LOGO_IMG,
			'width'  => 1000,
			'height' => 300,
		),
		'description'   => 'SooperCart provides expert gadget reviews, honest product recommendations, tech news, and buying guides for consumers looking for the best tech solutions.',
		'foundingDate'  => '2019',
		'email'         => SC_EMAIL,
		'sameAs'        => array(
			'https://www.facebook.com/SooperCartOfficial',
			'https://www.instagram.com/soopercart_',
			'https://www.linkedin.com/company/soopercartofficial',
			'https://bsky.app/profile/soopercart.bsky.social',
			'https://www.threads.com/@soopercart_',
		),
		'contactPoint'  => array(
			'@type'       => 'ContactPoint',
			'email'       => SC_EMAIL,
			'contactType' => 'editorial',
		),
	);

	$site = array(
		'@context'        => 'https://schema.org',
		'@type'           => 'WebSite',
		'@id'             => SC_SITE_URL . '/#website',
		'name'            => SC_SITE_NAME,
		'url'             => SC_SITE_URL,
		'description'     => SC_SITE_TAGLINE . ' – Expert Tech Recommendations and Buying Guides',
		'inLanguage'      => 'en-US',
		'publisher'       => array( '@id' => SC_SITE_URL . '/#organization' ),
		'potentialAction' => array(
			'@type'       => 'SearchAction',
			'target'      => array(
				'@type'       => 'EntryPoint',
				'urlTemplate' => SC_SITE_URL . '/?s={search_term_string}',
			),
			'query-input' => 'required name=search_term_string',
		),
	);

	$output  = '<script type="application/ld+json">' . wp_json_encode( $org,  JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
	$output .= '<script type="application/ld+json">' . wp_json_encode( $site, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";

	set_transient( $cache_key, $output, 12 * HOUR_IN_SECONDS );
	return $output;
}

