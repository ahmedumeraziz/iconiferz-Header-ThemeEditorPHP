// ================================================================
// HELPER — get real og:image mime type
// Reads actual attachment mime type instead of hardcoding webp.
// Falls back to image/webp for the static fallback banner.
// ================================================================
function soopercart_get_image_mime( $attachment_id = 0 ) {
	if ( $attachment_id ) {
		$mime = get_post_mime_type( $attachment_id );
		if ( $mime ) {
			return esc_attr( $mime );
		}
	}
	return 'image/webp'; // fallback banner is always webp
}


// ================================================================
// HELPER — get cached schema JSON string
// Uses WP transients so Organization + WebSite JSON is not
// regenerated on every single page request.
// ================================================================
