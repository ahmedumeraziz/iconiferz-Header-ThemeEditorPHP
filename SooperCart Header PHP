			echo '<script type="application/ld+json">' . wp_json_encode( $schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
			echo sc_static_schemas();
			echo '<link rel="preload" as="image" fetchpriority="high" href="' . esc_url( SC_LOGO_IMG ) . '">' . "\n";
			return;
		}

		// ════════════════════════════════════════════════════════
		// SINGLE POSTS
		// ════════════════════════════════════════════════════════
		if ( is_single() ) {
			global $post;

			$post_url    = get_permalink();
			$post_title  = get_the_title();
			$post_exc    = wp_strip_all_tags( get_the_excerpt() );
			$thumb_id    = get_post_thumbnail_id( $post->ID );
			$post_img    = $thumb_id ? get_the_post_thumbnail_url( $post->ID, 'large' ) : '';
			$pub_date    = get_the_date( 'c' );
			$mod_date    = get_the_modified_date( 'c' );
			$author_obj  = get_userdata( $post->post_author );

			// Category and tags
			$cats        = get_the_category( $post->ID );
			$primary_cat = ! empty( $cats ) ? $cats[0]->name : '';
			$tags_list   = get_the_tags( $post->ID );
			$tag_names   = array();
			if ( $tags_list && ! is_wp_error( $tags_list ) ) {
				foreach ( $tags_list as $t ) { $tag_names[] = $t->name; }
			}

			// Real image dimensions
			$img_src  = $thumb_id ? wp_get_attachment_image_src( $thumb_id, 'large' ) : false;
			$img_w    = $img_src ? (int) $img_src[1] : 1200;
			$img_h    = $img_src ? (int) $img_src[2] : 630;
			$img_mime = sc_image_mime( $thumb_id );
			$wc       = str_word_count( wp_strip_all_tags( $post->post_content ) );

			// ── Open Graph ────────────────────────────────────────
			echo '<meta property="og:type"                content="article">' . "\n";
			echo '<meta property="og:title"               content="' . esc_attr( $post_title ) . '">' . "\n";
			echo '<meta property="og:description"         content="' . esc_attr( $post_exc ) . '">' . "\n";
			echo '<meta property="og:url"                 content="' . esc_url( $post_url ) . '">' . "\n";
			echo '<meta property="article:published_time" content="' . esc_attr( $pub_date ) . '">' . "\n";
			echo '<meta property="article:modified_time"  content="' . esc_attr( $mod_date ) . '">' . "\n";
			// FIX 3 — always use Ahmed's canonical author URL
			echo '<meta property="article:author"         content="' . esc_url( SC_AUTHOR_URL ) . '">' . "\n";
			if ( $primary_cat ) {
				echo '<meta property="article:section" content="' . esc_attr( $primary_cat ) . '">' . "\n";
			}
			foreach ( $tag_names as $tag ) {
				echo '<meta property="article:tag" content="' . esc_attr( $tag ) . '">' . "\n";
			}
			if ( $post_img ) {
				echo '<meta property="og:image"        content="' . esc_url( $post_img ) . '">' . "\n";
				echo '<meta property="og:image:type"   content="' . $img_mime . '">' . "\n";
				echo '<meta property="og:image:width"  content="' . $img_w . '">' . "\n";
				echo '<meta property="og:image:height" content="' . $img_h . '">' . "\n";
				echo '<meta property="og:image:alt"    content="' . esc_attr( $post_title ) . '">' . "\n";
			} else {
				echo '<meta property="og:image"        content="' . esc_url( SC_SOCIAL_IMG ) . '">' . "\n";
				echo '<meta property="og:image:type"   content="image/webp">' . "\n";
				echo '<meta property="og:image:width"  content="1200">' . "\n";
				echo '<meta property="og:image:height" content="630">' . "\n";
				echo '<meta property="og:image:alt"    content="' . esc_attr( SC_SITE_NAME . ' – ' . SC_TAGLINE ) . '">' . "\n";
			}

			// ── Twitter Card ──────────────────────────────────────
			echo '<meta name="twitter:title"       content="' . esc_attr( $post_title ) . '">' . "\n";
			echo '<meta name="twitter:description" content="' . esc_attr( $post_exc ) . '">' . "\n";
			echo '<meta name="twitter:image"       content="' . esc_url( $post_img ? $post_img : SC_SOCIAL_IMG ) . '">' . "\n";
			echo '<meta name="twitter:creator"     content="' . esc_attr( SC_TWITTER ) . '">' . "\n";

			// ── FIX 2 — Author entity via dedicated helper ────────
			// Always returns Ahmed UA. with full sameAs + jobTitle
			// regardless of which WP account published the post
			$author_ent = sc_get_author_entity( $author_obj );

			// ── About entities from tags ──────────────────────────
			$about = array();
			if ( ! empty( $tags_list ) && ! is_wp_error( $tags_list ) ) {
				foreach ( $tags_list as $t ) { $about[] = array( '@type' => 'Thing', 'name' => $t->name ); }
			}

			// ── BlogPosting schema ────────────────────────────────
			$article = array(
				'@context'             => 'https://schema.org',
				'@type'                => 'BlogPosting',
				'@id'                  => $post_url . '#article',
				'headline'             => $post_title,
				'url'                  => $post_url,
				'datePublished'        => $pub_date,
				'dateModified'         => $mod_date,
				'wordCount'            => $wc,
				'inLanguage'           => 'en-US',
				'author'               => $author_ent,
				'publisher'            => array( '@id' => SC_SITE_URL . '/#organization' ),
				'description'          => $post_exc,
				'mainEntityOfPage'     => array( '@type' => 'WebPage', '@id' => $post_url ),
				'isPartOf'             => array( '@id' => SC_SITE_URL . '/#website' ),
				'copyrightYear'        => (int) get_the_date( 'Y' ),
				'copyrightHolder'      => array( '@id' => SC_SITE_URL . '/#organization' ),
				'speakable'            => array(
					'@type'       => 'SpeakableSpecification',
					'cssSelector' => array( 'h1.entry-title', '.entry-content > p:first-of-type' ),
				),
				'accessMode'           => array( 'textual', 'visual' ),
				'accessibilityFeature' => array( 'alternativeText', 'readingOrder' ),
			);

			if ( ! empty( $tag_names ) ) { $article['keywords'] = implode( ', ', $tag_names ); }
			if ( ! empty( $about ) )     { $article['about']    = $about; }
			if ( $post_img ) {
				$article['image'] = array( '@type' => 'ImageObject', 'url' => $post_img, 'width' => $img_w, 'height' => $img_h );
			}

			// Optional star rating
			$rating = sc_get_rating( $post->ID );
			if ( $rating ) {
				$article['reviewRating'] = array(
					'@type'       => 'Rating',
					'ratingValue' => $rating['ratingValue'],
					'bestRating'  => 5,
					'worstRating' => 1,
					'ratingCount' => $rating['ratingCount'],
				);
			}

			// Optional date reviewed
			$reviewed = get_post_meta( $post->ID, '_sc_reviewed', true );
			if ( $reviewed ) {
				$article['dateReviewed'] = sanitize_text_field( $reviewed );
				$article['reviewedBy']   = array( '@type' => 'Organization', 'name' => SC_SITE_NAME . ' Editorial Team' );
			}

			// Optional citations
			$sources = get_post_meta( $post->ID, '_sc_sources', true );
			if ( $sources ) {
				$cites = array();
				foreach ( array_filter( array_map( 'trim', explode( '||', $sources ) ) ) as $src ) {
					$cites[] = array( '@type' => 'CreativeWork', 'url' => esc_url( $src ) );
				}
				if ( ! empty( $cites ) ) { $article['citation'] = $cites; }
			}

			echo '<script type="application/ld+json">' . wp_json_encode( $article, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";

			sc_breadcrumb_schema();
			sc_output_faq_schema( $post->post_content );
			echo sc_static_schemas();

			// LCP: preload featured image with responsive srcset
			if ( $post_img && $thumb_id ) {
				$srcset = wp_get_attachment_image_srcset( $thumb_id, 'large' );
				$sizes  = wp_get_attachment_image_sizes( $thumb_id, 'large' );
				if ( $srcset && $sizes ) {
					echo '<link rel="preload" as="image" fetchpriority="high" href="' . esc_url( $post_img ) . '" imagesrcset="' . esc_attr( $srcset ) . '" imagesizes="' . esc_attr( $sizes ) . '">' . "\n";
				} else {
					echo '<link rel="preload" as="image" fetchpriority="high" href="' . esc_url( $post_img ) . '">' . "\n";
				}
			}
			return;
		}

		// ════════════════════════════════════════════════════════
		// CATEGORY ARCHIVES
		// ════════════════════════════════════════════════════════
		if ( is_category() ) {
			$cat    = get_queried_object();
			$c_url  = get_category_link( $cat->term_id );
			$c_name = $cat->name . ' Reviews & Guides | ' . SC_SITE_NAME;
			$c_desc = $cat->description
				? wp_strip_all_tags( $cat->description )
				: 'Browse ' . $cat->name . ' reviews and guides at ' . SC_SITE_NAME . ' – expert recommendations for the best gadgets.';

			echo '<meta property="og:type"         content="website">' . "\n";
			echo '<meta property="og:title"        content="' . esc_attr( $c_name ) . '">' . "\n";
			echo '<meta property="og:description"  content="' . esc_attr( $c_desc ) . '">' . "\n";
			echo '<meta property="og:url"          content="' . esc_url( $c_url ) . '">' . "\n";
			echo '<meta property="og:image"        content="' . esc_url( SC_SOCIAL_IMG ) . '">' . "\n";
			echo '<meta property="og:image:type"   content="image/webp">' . "\n";
			echo '<meta property="og:image:width"  content="1200">' . "\n";
			echo '<meta property="og:image:height" content="630">' . "\n";
			echo '<meta property="og:image:alt"    content="' . esc_attr( $cat->name . ' – ' . SC_SITE_NAME ) . '">' . "\n";
			echo '<meta name="twitter:title"       content="' . esc_attr( $c_name ) . '">' . "\n";
			echo '<meta name="twitter:description" content="' . esc_attr( $c_desc ) . '">' . "\n";
			echo '<meta name="twitter:image"       content="' . esc_url( SC_SOCIAL_IMG ) . '">' . "\n";

			$schema = array(
				'@context'    => 'https://schema.org',
				'@type'       => 'CollectionPage',
				'name'        => $c_name,
				'url'         => $c_url,
				'description' => $c_desc,
				'inLanguage'  => 'en-US',
				'isPartOf'    => array( '@id' => SC_SITE_URL . '/#website' ),
				'publisher'   => array( '@id' => SC_SITE_URL . '/#organization' ),
			);
			echo '<script type="application/ld+json">' . wp_json_encode( $schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
			sc_breadcrumb_schema();
			echo sc_static_schemas();
			echo '<link rel="preload" as="image" fetchpriority="high" href="' . esc_url( SC_LOGO_IMG ) . '">' . "\n";
			return;
		}

		// ════════════════════════════════════════════════════════
		// TAG ARCHIVES
		// ════════════════════════════════════════════════════════
		if ( is_tag() ) {
			$tag    = get_queried_object();
			$t_url  = get_tag_link( $tag->term_id );
			$t_name = $tag->name . ' | ' . SC_SITE_NAME;
			$t_desc = $tag->description
				? wp_strip_all_tags( $tag->description )
				: 'Articles tagged "' . $tag->name . '" – gadget reviews and tech insights at ' . SC_SITE_NAME . '.';

			echo '<meta property="og:type"         content="website">' . "\n";
			echo '<meta property="og:title"        content="' . esc_attr( $t_name ) . '">' . "\n";
			echo '<meta property="og:description"  content="' . esc_attr( $t_desc ) . '">' . "\n";
			echo '<meta property="og:url"          content="' . esc_url( $t_url ) . '">' . "\n";
			echo '<meta property="og:image"        content="' . esc_url( SC_SOCIAL_IMG ) . '">' . "\n";
			echo '<meta property="og:image:type"   content="image/webp">' . "\n";
			echo '<meta property="og:image:width"  content="1200">' . "\n";
			echo '<meta property="og:image:height" content="630">' . "\n";
			echo '<meta property="og:image:alt"    content="' . esc_attr( $tag->name . ' – ' . SC_SITE_NAME ) . '">' . "\n";
			echo '<meta name="twitter:title"       content="' . esc_attr( $t_name ) . '">' . "\n";
			echo '<meta name="twitter:description" content="' . esc_attr( $t_desc ) . '">' . "\n";
			echo '<meta name="twitter:image"       content="' . esc_url( SC_SOCIAL_IMG ) . '">' . "\n";

			$schema = array(
				'@context'    => 'https://schema.org',
				'@type'       => 'CollectionPage',
				'name'        => $t_name,
				'url'         => $t_url,
				'description' => $t_desc,
				'inLanguage'  => 'en-US',
				'isPartOf'    => array( '@id' => SC_SITE_URL . '/#website' ),
				'publisher'   => array( '@id' => SC_SITE_URL . '/#organization' ),
			);
			echo '<script type="application/ld+json">' . wp_json_encode( $schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
			sc_breadcrumb_schema();
			echo sc_static_schemas();
			echo '<link rel="preload" as="image" fetchpriority="high" href="' . esc_url( SC_LOGO_IMG ) . '">' . "\n";
			return;
		}

		// ════════════════════════════════════════════════════════
		// AUTHOR ARCHIVES
		// ════════════════════════════════════════════════════════
		if ( is_author() ) {
			$author  = get_queried_object();
			$a_url   = get_author_posts_url( $author->ID );
			$a_bio   = wp_strip_all_tags( $author->description );
			$a_name  = SC_AUTHOR_NAME . ' | ' . SC_SITE_NAME;
			$a_desc  = $a_bio ? $a_bio : SC_AUTHOR_DESC;
			$a_image = get_avatar_url( $author->ID, array( 'size' => 300 ) );

			echo '<meta property="og:type"         content="profile">' . "\n";
			echo '<meta property="og:title"        content="' . esc_attr( $a_name ) . '">' . "\n";
			echo '<meta property="og:description"  content="' . esc_attr( $a_desc ) . '">' . "\n";
			echo '<meta property="og:url"          content="' . esc_url( $a_url ) . '">' . "\n";
			echo '<meta property="og:image"        content="' . esc_url( SC_SOCIAL_IMG ) . '">' . "\n";
			echo '<meta property="og:image:type"   content="image/webp">' . "\n";
			echo '<meta property="og:image:width"  content="1200">' . "\n";
			echo '<meta property="og:image:height" content="630">' . "\n";
			echo '<meta property="og:image:alt"    content="' . esc_attr( SC_AUTHOR_NAME . ' – ' . SC_SITE_NAME ) . '">' . "\n";
			echo '<meta name="twitter:title"       content="' . esc_attr( $a_name ) . '">' . "\n";
			echo '<meta name="twitter:description" content="' . esc_attr( $a_desc ) . '">' . "\n";
			echo '<meta name="twitter:image"       content="' . esc_url( SC_SOCIAL_IMG ) . '">' . "\n";

			// Full Person schema — uses sc_get_author_entity() for consistency
			$author_obj = get_userdata( $author->ID );
			$person     = sc_get_author_entity( $author_obj );
			$person['@context']          = 'https://schema.org';
			$person['mainEntityOfPage']  = array( '@type' => 'WebPage', '@id' => $a_url );

			echo '<script type="application/ld+json">' . wp_json_encode( $person, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
			sc_breadcrumb_schema();
			echo sc_static_schemas();
			echo '<link rel="preload" as="image" fetchpriority="high" href="' . esc_url( SC_LOGO_IMG ) . '">' . "\n";
			return;
		}

		// ════════════════════════════════════════════════════════
		// STATIC PAGES (About, Contact, Privacy, Buying Guides…)
		// ════════════════════════════════════════════════════════
		if ( is_page() && ! is_front_page() ) {
			global $post;

			$p_url   = get_permalink();
			$p_title = get_the_title() . ' | ' . SC_SITE_NAME;
			$p_exc   = wp_strip_all_tags( get_the_excerpt() );
			$p_img   = get_the_post_thumbnail_url( $post->ID, 'large' );
			$p_tid   = get_post_thumbnail_id( $post->ID );

			echo '<meta property="og:type"  content="website">' . "\n";
			echo '<meta property="og:title" content="' . esc_attr( $p_title ) . '">' . "\n";
			if ( $p_exc ) {
				echo '<meta property="og:description" content="' . esc_attr( $p_exc ) . '">' . "\n";
			}
			echo '<meta property="og:url" content="' . esc_url( $p_url ) . '">' . "\n";
			if ( $p_img ) {
				echo '<meta property="og:image"      content="' . esc_url( $p_img ) . '">' . "\n";
				echo '<meta property="og:image:type" content="' . sc_image_mime( $p_tid ) . '">' . "\n";
				echo '<meta property="og:image:alt"  content="' . esc_attr( $p_title ) . '">' . "\n";
			} else {
				echo '<meta property="og:image"        content="' . esc_url( SC_SOCIAL_IMG ) . '">' . "\n";
				echo '<meta property="og:image:type"   content="image/webp">' . "\n";
				echo '<meta property="og:image:width"  content="1200">' . "\n";
				echo '<meta property="og:image:height" content="630">' . "\n";
				echo '<meta property="og:image:alt"    content="' . esc_attr( $p_title ) . '">' . "\n";
			}
			echo '<meta name="twitter:title"       content="' . esc_attr( $p_title ) . '">' . "\n";
			if ( $p_exc ) { echo '<meta name="twitter:description" content="' . esc_attr( $p_exc ) . '">' . "\n"; }
			echo '<meta name="twitter:image"       content="' . esc_url( $p_img ? $p_img : SC_SOCIAL_IMG ) . '">' . "\n";

			sc_breadcrumb_schema();
			sc_output_faq_schema( $post->post_content );
			echo sc_static_schemas();
			echo '<link rel="preload" as="image" fetchpriority="high" href="' . esc_url( SC_LOGO_IMG ) . '">' . "\n";
			return;
		}

		// ════════════════════════════════════════════════════════
		// ALL OTHER PAGES (WooCommerce, custom post types…)
		// ════════════════════════════════════════════════════════
		echo sc_static_schemas();
		echo '<link rel="preload" as="image" fetchpriority="high" href="' . esc_url( SC_LOGO_IMG ) . '">' . "\n";
	}
}

