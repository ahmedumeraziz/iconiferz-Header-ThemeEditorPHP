// HELPER — real MIME type for og:image:type
// ════════════════════════════════════════════════════════════════
if ( ! function_exists( 'sc_image_mime' ) ) {
	function sc_image_mime( $attachment_id = 0 ) {
		if ( $attachment_id ) {
