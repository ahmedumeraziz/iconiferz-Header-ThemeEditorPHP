// FIX 2 — HELPER — full Author entity for Ahmed UA.
// ────────────────────────────────────────────────────────────────
// Always returns Ahmed UA. with sameAs links, jobTitle, and
// knowsAbout — regardless of which WP user account published
// the post. This is what was missing in v9.0.
//
// The sameAs array contains three verifiable profile links that
// Google uses to confirm the author is a real person with
// genuine expertise (E-E-A-T "Experience" and "Expertise" signals).
//
// If $wp_user_obj is available, the Gravatar image is added too.
// ════════════════════════════════════════════════════════════════
if ( ! function_exists( 'sc_get_author_entity' ) ) {
	function sc_get_author_entity( $wp_user_obj = null ) {
		$entity = array(
			'@type'       => 'Person',
			'name'        => SC_AUTHOR_NAME,
			'url'         => SC_AUTHOR_URL,
			'jobTitle'    => SC_AUTHOR_JOB,
			'description' => SC_AUTHOR_DESC,
			'knowsAbout'  => array(
				'Gadget Reviews',
				'Consumer Electronics',
				'Smart Home Devices',
				'Mobile Technology',
				'Wearable Technology',
				'Car Tech Gadgets',
				'Audio Gadgets',
				'Gaming Accessories',
			),
			// Three verifiable profile links — Google cross-checks these
			'sameAs' => array(
				SC_AUTHOR_URL,
				'https://itkins.com/ahmedumeraziz/',
				'https://www.facebook.com/ahmedumeraziz',
				'https://www.linkedin.com/in/ahmedumeraziz/',
			),
			'worksFor' => array( '@id' => SC_SITE_URL . '/#organization' ),
		);

		// Add Gravatar if WP user object is available
		if ( $wp_user_obj ) {
			$entity['image'] = array(
				'@type'  => 'ImageObject',
				'url'    => get_avatar_url( $wp_user_obj->ID, array( 'size' => 300 ) ),
				'width'  => 300,
				'height' => 300,
			);
			// Merge extra sameAs from WP profile website field
			if ( ! empty( $wp_user_obj->user_url ) && ! in_array( $wp_user_obj->user_url, $entity['sameAs'], true ) ) {
				$entity['sameAs'][] = esc_url( $wp_user_obj->user_url );
			}
		}

		return $entity;
	}
}


