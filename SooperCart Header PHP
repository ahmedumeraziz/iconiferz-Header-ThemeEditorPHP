			'width'  => 1000,
			'height' => 300,
		),
		'description'   => 'SooperCart provides expert gadget reviews, honest product recommendations, tech news, and buying guides for consumers looking for the best tech solutions.',
		'foundingDate'  => '2019',
		'email'         => 'info@soopercart.com',
		'sameAs'        => array(
			'https://www.facebook.com/SooperCartOfficial',
			'https://www.instagram.com/soopercart_',
			'https://www.linkedin.com/company/soopercartofficial',
			'https://bsky.app/profile/soopercart.bsky.social',
			'https://www.threads.com/@soopercart_',
		),
		'contactPoint'  => array(
			'@type'       => 'ContactPoint',
			'email'       => 'info@soopercart.com',
			'contactType' => 'editorial',
		),
	);

	$site_schema = array(
		'@context'        => 'https://schema.org',
		'@type'           => 'WebSite',
		'name'            => 'SooperCart',
		'url'             => SOOPERCART_SITE_URL,
		'description'     => 'Best Gadgets & Honest Reviews – Expert Tech Recommendations and Buying Guides',
		'inLanguage'      => 'en-US',
		'potentialAction' => array(
			'@type'       => 'SearchAction',
			'target'      => array(
				'@type'       => 'EntryPoint',
				'urlTemplate' => SOOPERCART_SITE_URL . '/?s={search_term_string}',
			),
			'query-input' => 'required name=search_term_string',
