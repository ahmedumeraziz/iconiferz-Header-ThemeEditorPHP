			echo '<meta property="og:image:width"  content="1200">' . "\n";
			echo '<meta property="og:image:height" content="630">' . "\n";
			echo '<meta property="og:image:alt"    content="' . esc_attr( SC_SITE_NAME . ' – ' . SC_TAGLINE ) . '">' . "\n";
			echo '<meta name="twitter:title"       content="' . esc_attr( $hp_title ) . '">' . "\n";
