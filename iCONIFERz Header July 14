// ================================================================
// HOOK ADJUSTMENTS
// ================================================================

// Hide WordPress version generator footprint
remove_action( 'wp_head', 'wp_generator' );
add_filter( 'the_generator', '__return_empty_string' );

// DISABLE AVADA'S NATIVE METATAGS
// NOTE: For guaranteed priority these should also live in functions.php at priority 0.
add_filter( 'avada_meta_og', '__return_false' );
add_filter( 'avada_og_image', '__return_false' );
add_filter( 'avada_meta_description', '__return_false' );

// Hardened Avada check to prevent PHP Warnings on theme updates
if ( class_exists( 'Avada' ) && isset( Avada()->head ) && is_object( Avada()->head ) ) {
	remove_action( 'wp_head', array( Avada()->head, 'insert_og_meta' ), 5 );
	remove_action( 'wp_head', array( Avada()->head, 'add_og_meta_output' ), 5 );
	remove_action( 'wp_head', array( Avada()->head, 'insert_seo_meta' ), 5 );
}

// Remove default WordPress canonical tags
remove_action( 'wp_head', 'rel_canonical' );

// Appends site name to post documents cleanly
add_filter( 'document_title_parts', function( $title_parts ) {
	if ( is_singular() && ! is_front_page() ) {
		$title_parts['site'] = 'iCONIFERz';
	}
	return $title_parts;
}, 999 );

add_action( 'wp_head', 'iconiferz_seo_head', 1 );

// ================================================================
// TRANSIENT PURGE ON POST SAVE
// FIX: Guard against autosaves and revisions to prevent unnecessary cache busts.
// ================================================================
add_action( 'save_post', function( $post_id ) {
	// Skip autosaves
	if ( defined( 'DOING_AUTOSAVE' ) && DOING_AUTOSAVE ) {
		return;
	}
	// Skip post revisions
	if ( wp_is_post_revision( $post_id ) ) {
		return;
	}
	delete_transient( 'iconiferz_faq_' . $post_id );
} );


