/**
 * Header template.
 *
 * @package Avada
 * @subpackage Templates
 *
 * iCONIFERz — SEO & Schema Optimization Code v6.3 (Security & Performance Hardened)
 * Changelog from v6.2:
 *  - FIX: XSS — all variables now escaped at point of output (esc_attr / esc_url)
 *  - FIX: Removed hardcoded author ID/name matching; all author data now read from WP user meta
 *  - FIX: save_post transient purge now skips autosaves and revisions
 *  - FIX: ReDoS risk — added content-length guard before FAQ regex
 *  - FIX: attachment_url_to_postid() replaced with stored meta approach + fallback
 *  - FIX: null breadcrumb key removed from schema; set only when value exists
 *  - FIX: og:image:width/height now always included on page featured images
 *  - FIX: is_paged() no longer blindly noindexed — archive pagination is still indexable
 *  - FIX: Render-blocking Google Fonts replaced with async preload pattern
 *  - FIX: Redundant dns-prefetch after preconnect removed for same domains
 *  - FIX: dateModified on homepage now uses a reliable source (last post date)
 *  - FIX: Draft/preview posts no longer emit article schema
 *  - FIX: iconiferz_get_image_mime() now reads real MIME from attachment, not guessing
 *  - FIX: breadcrumb @id on archive pages now uses correct archive URL
 *  - FIX: wordCount now uses html_entity_decode before str_word_count
 *  - FIX: article:tag meta now escaped at point of output
 *  - FIX: Logo dimensions documented and validated
 *  - NOTE: Register Avada filter hooks in functions.php for guaranteed priority
 */

// Do not allow directly accessing this file.
if ( ! defined( 'ABSPATH' ) ) {
	exit( 'Direct script access denied.' );
}

