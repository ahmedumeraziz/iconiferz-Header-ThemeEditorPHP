	}

	$entity = array(
		'@type'       => 'Person',
		'name'        => $wp_user_obj->display_name,
		'url'         => esc_url( get_author_posts_url( $wp_user_obj->ID ) ),
		'jobTitle'    => 'Technology Journalist',
		'description' => 'Ahmed UA is a technology journalist with over 13 years of industry experience. He covers AI, cybersecurity, mobile technology, gadgets, and global tech trends for iCONIFERz.',
		'knowsAbout'  => array(
			'Artificial Intelligence',
			'Cybersecurity',
			'Mobile Technology',
			'Blockchain',
			'Technology Journalism',
			'Gadgets',
		),
		'sameAs'      => array(
			'https://itkins.com/ahmedumeraziz/',
			'https://www.facebook.com/ahmedumeraziz',
			'https://www.linkedin.com/in/ahmedumeraziz/',
		),
		'worksFor'    => array(
			'@type' => 'Organization',
			'name'  => 'iCONIFERz',
			'url'   => ICONIFERZ_SITE_URL,
		),
	);

