/**
 * Returns the real MIME type of an attachment.
 * FIX: No longer blindly returns image/webp as a default.
 * Falls back to image/webp only if no attachment is found.
 *
 * @param int $attachment_id
 * @return string
 */
if ( ! function_exists( 'iconiferz_get_image_mime' ) ) {
	function iconiferz_get_image_mime( $attachment_id = 0 ) {
		if ( $attachment_id ) {
			$mime = get_post_mime_type( (int) $attachment_id );
			if ( $mime ) {
				return esc_attr( $mime );
			}
		}
		return 'image/webp'; // Safe fallback for our own WEBP social images
	}
}

/**
 * Reads Avada-specific SEO meta fields.
 *
 * @param int    $post_id
 * @param string $key
 * @return string
 */
if ( ! function_exists( 'iconiferz_get_avada_seo_meta' ) ) {
	function iconiferz_get_avada_seo_meta( $post_id, $key ) {
		if ( function_exists( 'fusion_get_page_option' ) ) {
			$val = fusion_get_page_option( $key, $post_id );
			if ( ! empty( $val ) ) {
				return $val;
			}
		}
		return get_post_meta( $post_id, 'pyre_' . $key, true );
	}
}

