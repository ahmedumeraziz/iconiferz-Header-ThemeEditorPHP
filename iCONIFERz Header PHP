// ================================================================
// HELPER — build full Author entity for Ahmed UA
// ----------------------------------------------------------------
// FIX 1 & 2 — Full Person schema with sameAs links, jobTitle,
// knowsAbout array. This resolves the "no author credentials"
// E-E-A-T failure from the audit. The sameAs array links to
// Ahmed's Website, Facebook, and LinkedIn — all three signals
// Google uses to verify real human expertise.
//
// HOW TO UPDATE: change the values below if Ahmed's URLs change.
// ================================================================
function iconiferz_get_author_entity( $wp_user_obj ) {
	if ( ! $wp_user_obj ) {
		return array(
			'@type' => 'Organization',
			'name'  => 'iCONIFERz',
			'url'   => ICONIFERZ_SITE_URL,
		);
	}

	$entity = array(
		'@type'       => 'Person',
		'name'        => $wp_user_obj->display_name,
		'url'         => esc_url( get_author_posts_url( $wp_user_obj->ID ) ),
		// FIX 2 — jobTitle and knowsAbout strengthen E-E-A-T
		'jobTitle'    => 'Technology Journalist',
		'description' => 'With over 13 years of experience in the tech industry, Ahmed UA is a trusted voice in technology news covering AI, cybersecurity, mobile tech, gadgets, and industry trends.',
		'knowsAbout'  => array(
			'Artificial Intelligence',
			'Cybersecurity',
			'Mobile Technology',
			'Blockchain',
			'Technology Journalism',
			'Gadgets',
		),
		// FIX 1 — sameAs with all three profile links Google can verify
		'sameAs'      => array(
			'https://itkins.com/ahmedumeraziz/',
			'https://www.facebook.com/ahmedumeraziz',
			'https://www.linkedin.com/in/ahmedumeraziz/',
		),
		'worksFor'    => array(
			'@type' => 'Organization',
			'name'  => 'iCONIFERz',
			'url'   => ICONIFERZ_SITE_URL,
		),
	);

	// Gravatar as author image — E-E-A-T visual signal
	$entity['image'] = array(
		'@type' => 'ImageObject',
		'url'   => get_avatar_url( $wp_user_obj->ID, array( 'size' => 300 ) ),
	);

	// If the WP user profile has a website set, add it too
	if ( ! empty( $wp_user_obj->user_url ) ) {
		// Merge without duplicating
		if ( ! in_array( $wp_user_obj->user_url, $entity['sameAs'], true ) ) {
			$entity['sameAs'][] = esc_url( $wp_user_obj->user_url );
		}
	}

	return $entity;
}


// ================================================================
// FAQ AUTO-DETECTION — v4.0 (unchanged, working correctly)
// ================================================================
function iconiferz_extract_faqs( $post_content ) {
	$faqs     = array();
	$rendered = do_blocks( $post_content );

	// Method 1 — H2 "FAQ" section + H3/H4 questions
	$h2_sections = preg_split( '/<h2[^>]*>[\s\S]*?<\/h2>/i', $rendered );
	$h2_matches  = array();
	preg_match_all( '/<h2[^>]*>([\s\S]*?)<\/h2>/i', $rendered, $h2_matches, PREG_SET_ORDER );

	foreach ( $h2_matches as $idx => $h2_match ) {
		$h2_text        = trim( wp_strip_all_tags( $h2_match[1] ) );
		$is_faq_section = (
			stripos( $h2_text, 'faq' ) !== false ||
			stripos( $h2_text, 'frequently asked' ) !== false ||
			stripos( $h2_text, 'people also ask' ) !== false ||
			stripos( $h2_text, 'common questions' ) !== false ||
			stripos( $h2_text, 'questions' ) !== false
		);
		if ( ! $is_faq_section ) {
			continue;
		}
		$section_body = isset( $h2_sections[ $idx + 1 ] ) ? $h2_sections[ $idx + 1 ] : '';
		if ( empty( $section_body ) ) {
			continue;
		}
		if ( preg_match_all(
			'/<h[3-4][^>]*>([\s\S]*?)<\/h[3-4]>([\s\S]*?)(?=<h[2-4]|$)/i',
			$section_body,
			$q_matches,
			PREG_SET_ORDER
		) ) {
			foreach ( $q_matches as $q_match ) {
				$question    = trim( wp_strip_all_tags( $q_match[1] ) );
				$answer_html = $q_match[2];
				if ( ! $question || '?' !== substr( rtrim( $question ), -1 ) ) {
					continue;
				}
				$answer_parts = array();
				if ( preg_match_all( '/<p[^>]*>([\s\S]*?)<\/p>/i', $answer_html, $p_matches ) ) {
					foreach ( $p_matches[1] as $p ) {
						$part = trim( wp_strip_all_tags( $p ) );
						if ( $part ) {
							$answer_parts[] = $part;
						}
					}
				}
				$answer = implode( ' ', $answer_parts );
				if ( $question && $answer ) {
					$faqs[] = array( 'question' => $question, 'answer' => $answer );
				}
			}
		}
	}

	// Method 2 — Classic Editor <strong>Question?</strong>
	if ( empty( $faqs ) ) {
		if ( preg_match_all(
			'/<p[^>]*>\s*<strong[^>]*>([\s\S]*?)<\/strong>\s*<\/p>([\s\S]*?)(?=<p[^>]*>\s*<strong|$)/i',
			$rendered, $matches, PREG_SET_ORDER
		) ) {
			foreach ( $matches as $match ) {
				$question    = trim( wp_strip_all_tags( $match[1] ) );
				$answer_html = $match[2];
				if ( ! $question || '?' !== substr( rtrim( $question ), -1 ) ) { continue; }
				$answer_parts = array();
				if ( preg_match_all( '/<p[^>]*>([\s\S]*?)<\/p>/i', $answer_html, $p_matches ) ) {
					foreach ( $p_matches[1] as $p ) {
						$part = trim( wp_strip_all_tags( $p ) );
						if ( $part ) { $answer_parts[] = $part; }
					}
				}
				$answer = implode( ' ', $answer_parts );
				if ( $question && $answer ) { $faqs[] = array( 'question' => $question, 'answer' => $answer ); }
			}
		}
	}

	// Method 3 — Definition list <dt>/<dd>
	if ( empty( $faqs ) ) {
		if ( preg_match_all(
			'/<dt[^>]*>([\s\S]*?)<\/dt>[\s\S]{0,200}?<dd[^>]*>([\s\S]*?)<\/dd>/i',
			$rendered, $matches, PREG_SET_ORDER
		) ) {
			foreach ( $matches as $match ) {
				$question = trim( wp_strip_all_tags( $match[1] ) );
				$answer   = trim( wp_strip_all_tags( $match[2] ) );
				if ( $question && $answer && '?' === substr( rtrim( $question ), -1 ) ) {
					$faqs[] = array( 'question' => $question, 'answer' => $answer );
				}
			}
		}
	}

	// Method 4 — WP 6.3+ <details>/<summary> accordion
	if ( empty( $faqs ) ) {
		if ( preg_match_all(
			'/<details[^>]*>[\s\S]{0,100}?<summary[^>]*>([\s\S]*?)<\/summary>([\s\S]*?)<\/details>/i',
			$rendered, $matches, PREG_SET_ORDER
		) ) {
			foreach ( $matches as $match ) {
				$question    = trim( wp_strip_all_tags( $match[1] ) );
				$answer_html = $match[2];
				if ( ! $question || '?' !== substr( rtrim( $question ), -1 ) ) { continue; }
				$answer_parts = array();
				if ( preg_match_all( '/<p[^>]*>([\s\S]*?)<\/p>/i', $answer_html, $p_matches ) ) {
					foreach ( $p_matches[1] as $p ) {
						$part = trim( wp_strip_all_tags( $p ) );
						if ( $part ) { $answer_parts[] = $part; }
					}
				}
				$answer = implode( ' ', $answer_parts );
				if ( $question && $answer ) { $faqs[] = array( 'question' => $question, 'answer' => $answer ); }
			}
		}
	}

	// Deduplicate
	$seen  = array();
	$clean = array();
	foreach ( $faqs as $faq ) {
		$key = md5( $faq['question'] );
		if ( ! isset( $seen[ $key ] ) ) {
			$seen[ $key ] = true;
			$clean[]      = $faq;
		}
	}
	return $clean;
}


// ================================================================
// BREADCRUMB SCHEMA HELPER
// ================================================================
function iconiferz_breadcrumb_schema() {
	$items    = array();
	$position = 1;

	$items[] = array(
		'@type'    => 'ListItem',
		'position' => $position++,
		'name'     => 'Home',
		'item'     => home_url( '/' ),
	);

	if ( is_single() ) {
		$cats = get_the_category();
		if ( ! empty( $cats ) ) {
			$items[] = array(
				'@type'    => 'ListItem',
				'position' => $position++,
				'name'     => esc_html( $cats[0]->name ),
				'item'     => esc_url( get_category_link( $cats[0]->term_id ) ),
			);
		}
		$items[] = array(
			'@type'    => 'ListItem',
			'position' => $position++,
			'name'     => esc_html( get_the_title() ),
			'item'     => esc_url( get_permalink() ),
		);
	} elseif ( is_category() ) {
		$cat     = get_queried_object();
		$items[] = array(
			'@type'    => 'ListItem',
			'position' => $position++,
			'name'     => esc_html( $cat->name ),
			'item'     => esc_url( get_category_link( $cat->term_id ) ),
		);
	} elseif ( is_tag() ) {
		$tag     = get_queried_object();
		$items[] = array(
			'@type'    => 'ListItem',
			'position' => $position++,
			'name'     => esc_html( $tag->name ),
			'item'     => esc_url( get_tag_link( $tag->term_id ) ),
		);
	} elseif ( is_author() ) {
		$author  = get_queried_object();
		$items[] = array(
			'@type'    => 'ListItem',
			'position' => $position++,
			'name'     => esc_html( $author->display_name ),
			'item'     => esc_url( get_author_posts_url( $author->ID ) ),
		);
	} elseif ( is_page() && ! is_front_page() ) {
		$items[] = array(
			'@type'    => 'ListItem',
			'position' => $position++,
			'name'     => esc_html( get_the_title() ),
			'item'     => esc_url( get_permalink() ),
		);
	}

	if ( count( $items ) < 2 ) {
		return;
	}

	$schema = array(
		'@context'        => 'https://schema.org',
		'@type'           => 'BreadcrumbList',
		'itemListElement' => $items,
	);
	echo '<script type="application/ld+json">' . wp_json_encode( $schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
}


// ================================================================
// MAIN SEO HEAD FUNCTION
// ================================================================
function iconiferz_seo_head() {

	// ---------------------------------------------------------------
	// ROBOTS — handle thin/duplicate page types first
	// ---------------------------------------------------------------
	if ( is_search() ) {
		echo '<meta name="robots" content="noindex, follow">' . "\n";
		echo '<meta name="GPTBot" content="noindex">' . "\n";
		echo '<meta name="ClaudeBot" content="noindex">' . "\n";
		echo '<meta name="PerplexityBot" content="noindex">' . "\n";
		return;
	}
	if ( is_404() ) {
		echo '<meta name="robots" content="noindex, follow">' . "\n";
		return;
	}
	if ( is_date() ) {
		echo '<meta name="robots" content="noindex, follow">' . "\n";
		return;
	}
	// FIX 9 — noindex paginated archives (page 2, 3…) to avoid
	// thin duplicate content issues with Google's 2026 core signals
	if ( is_paged() ) {
		echo '<meta name="robots" content="noindex, follow">' . "\n";
		return;
	}

	// All real content pages — full indexing directive
	echo '<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">' . "\n";

	// ---------------------------------------------------------------
	// AI CRAWLER DIRECTIVES — June 2026
	// Explicitly allow AI crawlers to index and cite content.
	// ---------------------------------------------------------------
	echo '<meta name="GPTBot" content="index">' . "\n";
	echo '<meta name="ClaudeBot" content="index">' . "\n";
	echo '<meta name="PerplexityBot" content="index">' . "\n";

	// FIX 10 — llms.txt reference tag for AI crawler site structure
	// ACTION REQUIRED: create https://iconiferz.com/llms.txt — see note at bottom of file
	echo '<link rel="llms" href="' . ICONIFERZ_SITE_URL . '/llms.txt">' . "\n";

	// Global OG meta
	echo '<meta name="author" content="iCONIFERz">' . "\n";
	echo '<meta property="og:site_name" content="iCONIFERz">' . "\n";
	echo '<meta property="og:locale" content="en_US">' . "\n";

	// ---------------------------------------------------------------
	// HOMEPAGE
	// ---------------------------------------------------------------
	if ( is_front_page() ) {
		echo '<meta property="og:type" content="website">' . "\n";
		echo '<meta property="og:title" content="Technology News &amp; Insights | iCONIFERz">' . "\n";
		echo '<meta property="og:description" content="Stay ahead with iCONIFERz – your trusted source for the latest technology news, AI, cybersecurity, mobile tech, and innovation insights. Updated daily.">' . "\n";
		echo '<meta property="og:url" content="' . ICONIFERZ_SITE_URL . '/">' . "\n";
		echo '<meta property="og:image" content="' . ICONIFERZ_FALLBACK_SOCIAL_IMG . '">' . "\n";
		echo '<meta property="og:image:type" content="image/webp">' . "\n";
		echo '<meta property="og:image:width" content="1200">' . "\n";
		echo '<meta property="og:image:height" content="630">' . "\n";
		echo '<meta property="og:image:alt" content="iCONIFERz – Technology News &amp; Insights">' . "\n";

		$hp_schema = array(
			'@context'     => 'https://schema.org',
			'@type'        => 'WebPage',
			'name'         => 'Technology News & Insights | iCONIFERz',
			'url'          => ICONIFERZ_SITE_URL . '/',
			'description'  => 'Stay ahead with iCONIFERz – your trusted source for the latest technology news, AI, cybersecurity, mobile tech, and innovation insights. Updated daily.',
			'inLanguage'   => 'en-US',
			'isPartOf'     => array(
				'@type' => 'WebSite',
				'name'  => 'iCONIFERz',
				'url'   => ICONIFERZ_SITE_URL,
			),
			'publisher'    => array(
				'@type' => 'Organization',
				'name'  => 'iCONIFERz',
				'logo'  => array(
					'@type' => 'ImageObject',
					'url'   => ICONIFERZ_LOGO_IMG,
				),
			),
			'dateModified' => get_lastpostmodified( 'c' ),
		);
		echo '<script type="application/ld+json">' . wp_json_encode( $hp_schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
		echo iconiferz_get_static_schemas();
	}

	// ---------------------------------------------------------------
	// SINGLE POSTS
	// ---------------------------------------------------------------
	if ( is_single() ) {
		global $post;

		$post_url    = esc_url( get_permalink() );
		$post_title  = esc_attr( get_the_title() );
		$thumb_id    = get_post_thumbnail_id( $post->ID );
		$post_img    = get_the_post_thumbnail_url( $post->ID, 'large' );
		$pub_date    = get_the_date( 'c' );
		$mod_date    = get_the_modified_date( 'c' );
		$author_obj  = get_userdata( $post->post_author );
		$author_url  = esc_url( get_author_posts_url( $post->post_author ) );

		// FIX 4 — OG description: use excerpt, never allow empty fallback
		// get_the_excerpt() returns auto-generated excerpt if manual is empty
		$raw_excerpt = wp_strip_all_tags( get_the_excerpt() );
		$post_exc    = $raw_excerpt
			? esc_attr( $raw_excerpt )
			: esc_attr( wp_trim_words( wp_strip_all_tags( $post->post_content ), 30 ) );

		$cats        = get_the_category( $post->ID );
		$primary_cat = ! empty( $cats ) ? esc_attr( $cats[0]->name ) : '';

		$tags_list = get_the_tags( $post->ID );
		$tag_names = array();
		if ( $tags_list && ! is_wp_error( $tags_list ) ) {
			foreach ( $tags_list as $t ) {
				$tag_names[] = esc_attr( $t->name );
			}
		}

		$word_count = str_word_count( wp_strip_all_tags( $post->post_content ) );

		$img_src    = $thumb_id ? wp_get_attachment_image_src( $thumb_id, 'large' ) : false;
		$img_width  = $img_src ? (int) $img_src[1] : 1200;
		$img_height = $img_src ? (int) $img_src[2] : 630;
		$img_mime   = iconiferz_get_image_mime( $thumb_id );

		// Open Graph
		echo '<meta property="og:type" content="article">' . "\n";
		echo '<meta property="og:title" content="' . $post_title . '">' . "\n";
		echo '<meta property="og:description" content="' . $post_exc . '">' . "\n";
		echo '<meta property="og:url" content="' . $post_url . '">' . "\n";
		if ( $post_img ) {
			echo '<meta property="og:image" content="' . esc_url( $post_img ) . '">' . "\n";
			echo '<meta property="og:image:type" content="' . $img_mime . '">' . "\n";
			echo '<meta property="og:image:width" content="' . $img_width . '">' . "\n";
			echo '<meta property="og:image:height" content="' . $img_height . '">' . "\n";
			echo '<meta property="og:image:alt" content="' . $post_title . '">' . "\n";
		} else {
			echo '<meta property="og:image" content="' . ICONIFERZ_FALLBACK_SOCIAL_IMG . '">' . "\n";
			echo '<meta property="og:image:type" content="image/webp">' . "\n";
			echo '<meta property="og:image:width" content="1200">' . "\n";
			echo '<meta property="og:image:height" content="630">' . "\n";
			echo '<meta property="og:image:alt" content="iCONIFERz – Technology News &amp; Insights">' . "\n";
		}
		echo '<meta property="article:published_time" content="' . $pub_date . '">' . "\n";
		echo '<meta property="article:modified_time" content="' . $mod_date . '">' . "\n";
		if ( $primary_cat ) {
			echo '<meta property="article:section" content="' . $primary_cat . '">' . "\n";
		}
		foreach ( $tag_names as $tag ) {
			echo '<meta property="article:tag" content="' . $tag . '">' . "\n";
		}

		// -------------------------------------------------------
		// BlogPosting Schema — E-E-A-T enhanced for 2026
		// -------------------------------------------------------

		// FIX 1 — use full author entity builder (resolves "no author" E-E-A-T failure)
		$author_entity = iconiferz_get_author_entity( $author_obj );

		// About — named entities from tags (Knowledge Graph signal)
		$about_entities = array();
		if ( ! empty( $tags_list ) && ! is_wp_error( $tags_list ) ) {
			foreach ( $tags_list as $t ) {
				$about_entities[] = array( '@type' => 'Thing', 'name' => $t->name );
			}
		}

		// FIX 5 — speakable selectors updated to match Avada's actual output classes
		$speakable = array(
			'@type'       => 'SpeakableSpecification',
			'cssSelector' => array( 'h1.fusion-post-title', '.entry-content p:first-of-type', '.post-title' ),
		);

		$article_schema = array(
			'@context'         => 'https://schema.org',
			'@type'            => 'BlogPosting',
			'headline'         => get_the_title(),
			'url'              => get_permalink(),
			'datePublished'    => $pub_date,
			'dateModified'     => $mod_date,
			'wordCount'        => $word_count,
			'inLanguage'       => 'en-US',
			'author'           => $author_entity,
			'publisher'        => array(
				'@type' => 'Organization',
				'name'  => 'iCONIFERz',
				'logo'  => array(
					'@type'  => 'ImageObject',
					'url'    => ICONIFERZ_LOGO_IMG,
					'width'  => 1000,
					'height' => 300,
				),
			),
			'description'      => wp_strip_all_tags( get_the_excerpt() ),
			'mainEntityOfPage' => array(
				'@type' => 'WebPage',
				'@id'   => get_permalink(),
			),
			// FIX 7 — isPartOf creates the WebSite entity chain Google uses for sitelinks
			'isPartOf'         => array(
				'@type' => 'WebSite',
				'name'  => 'iCONIFERz',
				'url'   => ICONIFERZ_SITE_URL,
			),
			'copyrightYear'    => (int) get_the_date( 'Y' ),
			'copyrightHolder'  => array(
				'@type' => 'Organization',
				'name'  => 'iCONIFERz',
			),
			'speakable'        => $speakable,
			'accessMode'       => array( 'textual', 'visual' ),
			'accessibilityFeature' => array( 'alternativeText', 'readingOrder' ),
		);

		if ( ! empty( $tag_names ) ) {
			$article_schema['keywords'] = implode( ', ', array_map( 'wp_strip_all_tags', $tag_names ) );
		}
		if ( ! empty( $about_entities ) ) {
			$article_schema['about'] = $about_entities;
		}
		if ( $post_img ) {
			$article_schema['image'] = array(
				'@type'  => 'ImageObject',
				'url'    => $post_img,
				'width'  => $img_width,
				'height' => $img_height,
			);
		}

		// dateReviewed — reads custom meta field if editor fills it in
		// Usage: add_post_meta($id, '_iconiferz_reviewed', '2026-06-01')
		$reviewed_date = get_post_meta( $post->ID, '_iconiferz_reviewed', true );
		if ( $reviewed_date ) {
			$article_schema['dateReviewed'] = esc_attr( $reviewed_date );
			$article_schema['reviewedBy']   = array(
				'@type' => 'Organization',
				'name'  => 'iCONIFERz Editorial Team',
			);
		}

		// citation — reads custom meta field for sourced articles
		// Usage: add_post_meta($id, '_iconiferz_sources', 'url1||url2')
		$sources_raw = get_post_meta( $post->ID, '_iconiferz_sources', true );
		if ( $sources_raw ) {
			$source_urls = array_filter( array_map( 'trim', explode( '||', $sources_raw ) ) );
			$citations   = array();
			foreach ( $source_urls as $src_url ) {
				$citations[] = array( '@type' => 'CreativeWork', 'url' => esc_url( $src_url ) );
			}
			if ( ! empty( $citations ) ) {
				$article_schema['citation'] = $citations;
			}
		}

		echo '<script type="application/ld+json">' . wp_json_encode( $article_schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";

		iconiferz_breadcrumb_schema();

		// FAQ schema
		$faqs = iconiferz_extract_faqs( $post->post_content );
		if ( ! empty( $faqs ) ) {
			$faq_entities = array();
			foreach ( $faqs as $faq ) {
				$faq_entities[] = array(
					'@type'          => 'Question',
					'name'           => $faq['question'],
					'acceptedAnswer' => array(
						'@type' => 'Answer',
						'text'  => $faq['answer'],
					),
				);
			}
			$faq_schema = array(
				'@context'   => 'https://schema.org',
				'@type'      => 'FAQPage',
				'mainEntity' => $faq_entities,
			);
			echo '<script type="application/ld+json">' . wp_json_encode( $faq_schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";
		}

		echo iconiferz_get_static_schemas();

		// FIX 6 — LCP preload: responsive srcset for featured image
		if ( $post_img && $thumb_id ) {
			$srcset = wp_get_attachment_image_srcset( $thumb_id, 'large' );
			$sizes  = wp_get_attachment_image_sizes( $thumb_id, 'large' );
			if ( $srcset && $sizes ) {
				echo '<link rel="preload" as="image" fetchpriority="high"'
					. ' href="' . esc_url( $post_img ) . '"'
					. ' imagesrcset="' . esc_attr( $srcset ) . '"'
					. ' imagesizes="' . esc_attr( $sizes ) . '">' . "\n";
			} else {
				echo '<link rel="preload" as="image" fetchpriority="high" href="' . esc_url( $post_img ) . '">' . "\n";
			}
		}
	}

	// ---------------------------------------------------------------
	// CATEGORY PAGES
	// ---------------------------------------------------------------
	if ( is_category() ) {
		$cat_obj  = get_queried_object();
		$cat_name = esc_attr( $cat_obj->name );
		$cat_url  = esc_url( get_category_link( $cat_obj->term_id ) );
		$cat_desc = strip_tags( $cat_obj->description );
		$cat_og   = $cat_desc
			? esc_attr( $cat_desc )
			: 'Browse all ' . $cat_name . ' articles on iCONIFERz – latest technology news and expert insights.';

		echo '<meta property="og:type" content="website">' . "\n";
		echo '<meta property="og:title" content="' . $cat_name . ' News &amp; Insights | iCONIFERz">' . "\n";
		echo '<meta property="og:description" content="' . $cat_og . '">' . "\n";
		echo '<meta property="og:url" content="' . $cat_url . '">' . "\n";
		echo '<meta property="og:image" content="' . ICONIFERZ_FALLBACK_SOCIAL_IMG . '">' . "\n";
		echo '<meta property="og:image:type" content="image/webp">' . "\n";
		echo '<meta property="og:image:width" content="1200">' . "\n";
		echo '<meta property="og:image:height" content="630">' . "\n";
		echo '<meta property="og:image:alt" content="' . $cat_name . ' – iCONIFERz">' . "\n";

		$collection_schema = array(
			'@context'    => 'https://schema.org',
			'@type'       => 'CollectionPage',
			'name'        => $cat_name . ' News & Insights | iCONIFERz',
			'url'         => $cat_url,
			'description' => wp_strip_all_tags( $cat_og ),
			'inLanguage'  => 'en-US',
			'isPartOf'    => array(
				'@type' => 'WebSite',
				'name'  => 'iCONIFERz',
				'url'   => ICONIFERZ_SITE_URL,
			),
		);
		echo '<script type="application/ld+json">' . wp_json_encode( $collection_schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . '</script>' . "\n";

		iconiferz_breadcrumb_schema();
	}

	// ---------------------------------------------------------------
	// AUTHOR ARCHIVE
	// ---------------------------------------------------------------
	if ( is_author() ) {
		$author    = get_queried_object();
